# YOLO OBB dataset configuration.
# Copy to data.yaml and fill in your own paths / class names.
#
# See: https://docs.ultralytics.com/datasets/obb/

path: /home/xlf/Beingbeyond_D1/object_detect/dataset
train: images/train
val: images/val

# Class names (order must match label indices)
names:
  0: red_block
  1: blue_block
  2: yellow_block
nc: 3

# Data augmentation (optional overrides)
# hsv_h: 0.15
# hsv_s: 0.8
# hsv_v: 0.5
# degrees: 180.0
# translate: 0.6
# scale: 0.5
# shear: 30.0
# perspective: 0.005
# flipud: 0.5
# fliplr: 0.5
# mosaic: 1.0
# mixup: 0.3
# cutmix: 0.5
